cff-version: 1.2.0
message: "If you use this repository, please cite it as below."
title: "Regulatory-Focus Framing in Geographically Targeted Advertisements for Citizen Science: A Randomized Experiment Across Spanish Municipalities"
type: software
authors:
  - family-names: Dekramanjian
    given-names: Berj
    orcid: "https://orcid.org/0000-0001-9672-422X"
    affiliation: "Universitat Pompeu Fabra"
  - family-names: Palmer
